{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-flash:free",
  "plugin": ["opencode-claude-code-bridge"],
  "permission": {
    "bash": {
    "cat *": "allow",
    "docker ps": "allow",
    "edit": "ask",
    "find *": "allow",
    "git diff": "allow",
    "git status": "allow",
    "gh issue view *": "allow",
    "grep *": "allow",
    "ls *": "allow",
    "* --help": "allow",
    "* --version": "allow",
    "* -h": "allow",
    "* -v": "allow",
    "*": "ask"
    }
  }
}
