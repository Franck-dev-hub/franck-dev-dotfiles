{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:3b",
  "plugin": ["opencode-claude-code-bridge"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {},
        "qwen2.5:3b": {}
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "docker ps": "allow",
      "find *": "allow",
      "git diff": "allow",
      "git status": "allow",
      "gh issue view *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "* --help": "allow",
      "* --version": "allow",
      "* -h": "allow",
      "* -v": "allow"
    }
  }
}
