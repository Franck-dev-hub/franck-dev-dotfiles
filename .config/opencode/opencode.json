{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder:30b",
  "plugin": ["opencode-claude-code-bridge"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (Code)"
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (Chat)"
        },
        "deepseek-coder-v2:16b": {
          "name": "DeepSeek Coder V2 16B (Code, backup)"
        },
        "llama3.1:8b": {
          "name": "Llama 3.1 8B (Chat, backup)"
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "docker ps": "allow",
      "find *": "allow",
      "git diff": "allow",
      "git status": "allow",
      "gh issue view *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "* --help": "allow",
      "* --version": "allow",
      "* -h": "allow",
      "* -v": "allow"
    }
  }
}
