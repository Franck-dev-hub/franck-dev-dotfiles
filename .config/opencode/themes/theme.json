{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "nightBg": "#1a1b26",
    "stormBg": "#24283b",
    "darkPanel": "#1f2335",
    "fg": "#c0caf5",
    "fgMuted": "#565f89",
    "comment": "#565f89",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "green": "#9ece6a",
    "purple": "#bb9af7",
    "orange": "#ff9e64",
    "red": "#f7768e",
    "yellow": "#e0af68",
    "teal": "#1abc9c",
    "black": "#15161e",
    "terminalBlack": "#414868",
    "white": "#c0caf5",
    "primaryBlue": "#667EEA"
  },
  "theme": {
    "primary": {
      "dark": "primaryBlue",
      "light": "primaryBlue"
    },
    "secondary": {
      "dark": "purple",
      "light": "purple"
    },
    "accent": {
      "dark": "cyan",
      "light": "cyan"
    },
    "error": {
      "dark": "red",
      "light": "red"
    },
    "warning": {
      "dark": "orange",
      "light": "orange"
