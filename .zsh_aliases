# ===================== Navigation & Files =====================
# ----- ls -----
alias ls="lsd --group-dirs first"
alias ll="ls -Alh"
alias lla="eza -Alh --total-size"
alias lls="ls -Alh --total-size"
# ----- grep -----
alias grep="grep --color=auto"
# ----- cd -----
alias cdobs="cd ~/Nextcloud/Franck/Obsidian"
alias cdemagma="cd ~/Documents/Emagma"
alias cdperso="cd ~/Documents/Perso"

# ===================== Editor =====================
alias n="nvim"
alias v="nvim"
alias vi="nvim"
alias vim="nvim"
# THE MOST IMPORTANT COMMAND
alias nano="vim"

# ===================== Git =====================
alias gs="clear && git status"
alias gss="git show --stat"
alias ga="git add"
alias gc="git commit"
alias gci="~/.local/share/scripts/commit.sh"
alias gcm="git commit -m"
alias gac="git add . && git commit"
alias gacm="git add . && git commit -m"
alias gca="git commit --amend"
alias gcan="git commit --amend --no-edit"
alias gp="git push"
alias gpull="git pull"
alias gpf="git push --force-with-lease"
alias gcanf="git commit --amend --no-edit && git push --force-with-lease"
alias gd="git diff"
alias gds="git diff --stat"
alias ghpr="git push --set-upstream origin HEAD && gh pr create --draft --fill"
alias glpr="git push --set-upstream origin HEAD -o merge_request.create -o merge_request.draft"
alias glsdev="! git checkout develop && git pull --prune && git fetch --prune && git branch -d @{-1}"
alias grebase="rebase --rebase-merges"
alias gtags="!git tag | sort -V"

# ===================== Docker Compose =====================
alias docker-compose="docker compose"
alias dc="docker compose"
alias dcd="dc down"
alias dcb="dc build"
alias dcu="dc up"
alias dcr="dc restart"
alias dcs="dc ps"
alias dcss="dcs --services"
alias dcl="dc logs -f --tail=50"

# ===================== C =====================
alias gcch="gcc -Wall -pedantic -Werror -Wextra -std=gnu89"
alias val="clear && valgrind --leak-check=full --track-origins=yes --show-leak-kinds=all"
alias cbetty="clear && betty *"

# ===================== Bash =====================
alias shbang="echo '#\!/usr/bin/bash' | tee -ii *.sh"

# ===================== JS =====================
alias jsbang="echo '#\!/usr/bin/node' | tee -ii *.js"
alias ssa="semistandard *.js"
alias ssaf="semistandard --fix"

# ===================== Python =====================
alias pcheck='f() { uv run flake8 "$1" && uv run ruff check "$1"; }; f'
alias pformat='f() { uv run ruff format "$1" && uv run ruff check "$1"; }; f'
alias pybang="echo '#\!/usr/bin/env python3' | tee -ii *.py"
alias uv-venv="uv init && uv venv .venv && source .venv/bin/activate"
alias uv-req="uv pip compile pyproject.toml -o requirements.txt"

# ===================== Symfony =====================
alias sf='symfony console'
alias sfcc='symfony console cache:clear'
alias sfdsuf='symfony console doctrine:schema:update --force'

# ===================== Sylius =====================
alias syvers="php -v | grep PHP && echo '----------\nSymfony' && composer show symfony/framework-bundle | grep versions && echo '----------\nSylius' && composer show sylius/sylius | grep versions"
alias sylius_cve="~/.local/share/scripts/sylius_cve.py"
alias sylius_version="~/.local/share/scripts/sylius_version.sh"
alias sylius_dpv="~/.local/share/scripts/dependency_version.sh"

# ===================== LLM =====================
alias cloclo="claude -c"
alias openc="opencode"
alias opencc="opencode -c"

# ===================== Configs =====================
alias zshrc="n ${HOME}/.zshrc && source ${HOME}/.zshrc"
alias zsh_aliases="n ${HOME}/.zsh_aliases && source ${HOME}/.zshrc"

# ===================== Functions =====================
alias mkfile="~/.local/share/scripts/mkfile.sh"
alias app-img="~/.local/share/scripts/app-img-manager.sh"

# ===================== System tools =====================
alias ff="fastfetch"
alias ffm="fastfetch --config ${HOME}/.config/fastfetch/start.jsonc"
alias ffhard="fastfetch --config ${HOME}/.config/fastfetch/hardware.jsonc"
alias lov="love ./"
# Use : sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
